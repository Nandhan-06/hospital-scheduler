# Copy this file to .env and fill in your key.

# offline = fully deterministic, no network calls, no API key needed
# live    = uses Gemini for request parsing + worker blurbs
DEMO_MODE=offline

# Get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Any current free-tier Gemini model works, e.g. gemini-2.0-flash
GEMINI_MODEL=gemini-2.0-flash
